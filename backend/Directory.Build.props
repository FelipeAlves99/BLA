<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <!--
    NuGetAuditSuppress: advisory-level suppressions for CVEs with no patched upstream version.
    Each entry must be re-evaluated when upgrading the affected package.
    Suppress only vulnerabilities in code paths we do not exercise (XML sigs, OTLP edge cases).
  -->
  <ItemGroup Label="NuGet audit suppressions">
    <!-- System.Security.Cryptography.Xml (transitive via Testcontainers) — affects SignedXml, which we do not use -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-37gx-xxp4-5rgx" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-w3x6-4m5h-cxqf" />
  </ItemGroup>
</Project>
